export generatedToast = frame : madlib.newToast {
  title: "Generated / Existing toast",
  caption: "Same toast, generation message; no Undo action.",
  meta: {code: "madlib-maker/js/generate.js#finish"},
  left: 0px,
  top: 2800px,
  width: 500px,
  height: .auto,
  overrides: [remove(toasts.toast.undo)],

  message {
    width: 380px,
    contents: "Generated. Check the blanks before sharing."
  }
}

export confirmDialog = frame : madlib.library {
  title: "Confirm / Start a new madlib",
  caption: "Shown when Generate is clicked with a title or story in the editor. Continue goes on to AI settings or Generate; an empty editor skips this.",
  meta: {code: "madlib-maker/js/generate.js#buildConfirm"},
  left: 0px,
  top: 3200px,
  overrides: [
    insert(confirmBody, after = madlib.library.header),
    remove(dialogs.dialog.content)
  ],

  header {
    heading {
      contents: "Start a new madlib?"
    }
  }

  confirmBody = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 18px},
    padding: [18px, 23px, 23px],
    children: [message, actions],

    message = text : typeScale.body {
      width: 100%,
      contents: "The generated madlib opens in the editor in place of this one. This one stays saved in My madlibs."
    }

    actions = frame {
      width: 100%,
      height: .auto,
      layout: {justify-content: .end, item-gap: 8px},
      children: [cancel, continueButton],

      cancel = frame : buttons.secondary {
        height: 44px,
        padding-top: 0px,
        padding-left: 12px,
        padding-bottom: 0px,
        padding-right: 12px,

        label {
          contents: "CANCEL",
          font-size: 11.52
        }
      }

      continueButton = frame : buttons.button {
        height: 44px,
        padding-top: 0px,
        padding-left: 16px,
        padding-bottom: 0px,
        padding-right: 16px,

        label {
          contents: "CONTINUE",
          font-size: 11.52
        }
      }
    }
  }
}

@variant
export confirmFocus = frame : confirmDialog {
  title: "Confirm / Keyboard focus",
  caption: "Continue has focus when the dialog opens; Escape or Cancel keeps the current madlib.",
  left: 800px,
  top: 3200px,

  confirmBody {
    actions {
      continueButton {
        border[0].color: palette.colors.focus,
        border[0].width: 3px
      }
    }
  }
}
