          border[0].width: 3px
        }
      }

      field {
        border[0].color: palette.colors.focus,

        models {
          border[0].color: palette.colors.focus,
          border[0].width: 3px,
          border[0].sides: .all
        }

        border[0].width: 2px
      }
    }

    apiKey {
      field {
        border[0].color: palette.colors.focus,

        check {
          border[0].color: palette.colors.focus,
          border[0].width: 3px,
          border[0].sides: .all
        }

