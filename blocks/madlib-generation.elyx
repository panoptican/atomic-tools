import "blocks/dialog.elyx" as dialogs
import "tokens/colors.elyx" as palette
import "foundations/typography.elyx" as typeScale
import "controls/button.elyx" as buttons
import "controls/input.elyx" as inputs
import "controls/textarea.elyx" as textareas
import "controls/madlib-generate.elyx" as controls
import "blocks/madlib-creator.elyx" as madlib
import "blocks/toast.elyx" as toasts

export aiSettingsDialog = frame : madlib.library {
  title: "AI settings / First use",
  caption: "Claude default · Empty password field · Remember checked · Provider mismatch is advisory.",
  meta: {code: "madlib-maker/js/generate.js#buildSettings"},
  left: 0px,
  top: 0px,
  overrides: [
    insert(settingsForm, after = madlib.library.header),
    remove(dialogs.dialog.content)
  ],

  header {
    heading {
      contents: "AI settings"
    }
  }

  settingsForm = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 16px},
    padding: [18px, 23px, 23px],
    children: [
      providerGroup,
      apiKey,
      keyStatus,
      model,
      remember,
      storageNotice,
      privacyNote,
      actions
    ],

    providerGroup = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 6px},
      children: [label, providerPicker],

      label = text : typeScale.caption {
        contents: "PROVIDER"
      }

      providerPicker = frame : controls.providerPicker {}
    }

    apiKey = frame : inputs.input {
      width: 100%,
      overrides: [remove(inputs.input.helper)],

      field {
        overrides: [insert(check, after = inputs.input.field.value)],
        border[0].color: palette.colors.ink,
        fill[0].color: palette.colors.paper,

        value {
          width: 75%,
          contents: "Enter your API key"
        }

        layout.justify-content: .space-between,
        padding-right: 0px
      }

      label {
        contents: "API KEY"
      }

      check = frame : controls.checkButton {
        title: "",
        caption: ""
      }
    }

    keyStatus = text : typeScale.small {
      width: 100%,
      display: .none,
      contents: "Key works"
    }

    // The model list and its error hang directly under the field, like a select
    model = frame : inputs.input {
      width: 100%,
      overrides: [
        insert(modelList, after = inputs.input.field),
        insert(modelStatus, after = modelList),
        remove(inputs.input.helper)
      ],

      field {
        overrides: [insert(models, after = inputs.input.field.value)],
        border[0].color: palette.colors.ink,
        fill[0].color: palette.colors.paper,

        value {
          fill[0].color: palette.colors.ink,
          width: 70%,
          contents: "claude-opus-5-5"
        }

        layout.justify-content: .space-between,
        padding-right: 0px
      }

      label {
        contents: "MODEL"
      }

      models = frame : controls.modelsButton {
        title: "",
        caption: ""
      }
    }

    modelList = frame {
      width: 100%,
      height: .auto,
      display: .none,
      layout: {direction: .column},
      border: palette.colors.rule,
      children: [opus, sonnet, haiku],

      opus = frame : buttons.button {
        width: 100%,
        height: 44px,
        layout.justify-content: .start,

        label {
          contents: "claude-opus-5-5",
          font-size: 14,
          letter-spacing: 0
        }
      }

      sonnet = frame : buttons.secondary {
        width: 100%,
        height: 44px,
        border[0].color: palette.colors.rule,
        layout.justify-content: .start,

        label {
          contents: "claude-sonnet-5-5",
          font-size: 14,
          letter-spacing: 0
        }
      }

      haiku = frame : buttons.secondary {
        width: 100%,
        height: 44px,
        border[0].color: palette.colors.rule,
        layout.justify-content: .start,

        label {
          contents: "claude-haiku-5-5",
          font-size: 14,
          letter-spacing: 0
        }
      }
    }

    modelStatus = text : typeScale.small {
      width: 100%,
      display: .none,
      contents: "Couldn't reach Claude. Check your connection and try again.",
      fill[0].color: palette.colors.error
    }

    remember = frame : controls.rememberCheckbox {}

    storageNotice = text : typeScale.small {
      width: 100%,
      display: .none,
      contents: "Your key won't be remembered in this browser.",
      fill[0].color: palette.colors.muted
    }

    privacyNote = text : typeScale.small {
      width: 100%,
      contents: "Your key is stored in this browser and sent only to Claude. It's never included in share links. Use a key with a spend limit.",
      fill[0].color: palette.colors.muted
    }

    actions = frame {
      width: 100%,
      height: .auto,
      layout: {justify-content: .end, item-gap: 8px, wrap: .true, line-gap: 8px},
      children: [forgetKey, save],

      forgetKey = frame : buttons.secondary {
        height: 44px,
        display: .none,
        padding-top: 0px,
        padding-left: 12px,
        padding-bottom: 0px,
        padding-right: 12px,

        label {
          contents: "FORGET KEY",
          font-size: 11.52
        }
      }

      save = frame : buttons.button {
        height: 44px,
        padding-top: 0px,
        padding-left: 16px,
        padding-bottom: 0px,
        padding-right: 16px,

        label {
          contents: "SAVE",
          font-size: 11.52
        }
      }
    }
  }
}

@variant
export keySaved = frame : aiSettingsDialog {
  title: "AI settings / Key saved",
  caption: "Password remains masked; never render a saved key in plain text.",
  left: 800px,
  top: 0px,

  settingsForm {
    apiKey {
      field {
        value {
          fill[0].color: palette.colors.ink,
          contents: "••••••••••••••••••••••••"
        }
      }
    }

    actions {
      forgetKey {
        display: .visible
      }
    }
  }
}

