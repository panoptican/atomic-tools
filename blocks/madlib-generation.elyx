@variant
export generating = frame : generateReady {
  title: "Generate / Generating",
  caption: "Prompt, length, humor and settings locked; Cancel remains keyboard accessible and restores the prompt.",
  left: 4000px,
  top: 1400px,

  generateForm {
    prompt {
      field {
        fill[0].color: palette.colors.disabled,

        value {
          fill[0].color: palette.colors.disabledInk
        }
      }
    }

    actions {
      buttonsRow {
        generate {
          fill[0].color: palette.colors.disabled,
          border[0].color: palette.colors.disabled,

          label {
            fill[0].color: palette.colors.disabledInk,
            contents: "GENERATING…"
          }
        }

        cancel {
          display: .visible
        }
      }

      aiSettings {
        opacity: 0.5
      }
    }

    lengthPicker {
      opacity: 0.5
    }

    settingsGroup {
      opacity: 0.5
    }

    progressMessage {
      display: .visible
    }
  }

  header {
    close {
      display: .none
    }
  }
}

