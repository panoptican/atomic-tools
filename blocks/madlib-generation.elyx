        }
      }
    }
  }

  header {
    close {
      border[0].color: palette.colors.focus,
      border[0].width: 3px
    }
  }
}

export generateDialog = frame : madlib.library {
  title: "Generate / Empty",
  caption: "Required prompt · 500 character limit · Medium · Humor off · Generate disabled.",
  meta: {code: "madlib-maker/js/generate.js#buildGenerate"},
  left: 0px,
  top: 1400px,
  overrides: [
    insert(generateForm, after = madlib.library.header),
    remove(dialogs.dialog.content)
  ],

  header {
    heading {
      contents: "Generate a madlib"
    }
  }

  generateForm = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 20px},
    padding: [18px, 23px, 23px],
    children: [
      prompt,
      lengthPicker,
      settingsGroup,
      progressMessage,
      errorMessage,
      validationMessage,
      actions
    ],

    prompt = frame : textareas.textarea {
      width: 100%,

      field {
        fill[0].color: palette.colors.paper,
        border[0].color: palette.colors.ink,
        height: 128px,

        value {
          contents: "A pirate's first day at school",
          font-size: 16,
          font-family: "GT America",
          font-style: "Medium",
          line-height: 1.5
        }

        padding-top: 12px,
        padding-left: 12px,
        padding-bottom: 12px,
        padding-right: 12px
      }

      label {
        contents: "PROMPT (REQUIRED)"
      }

      helper {
        contents: "0 / 500 characters",
        font-size: 12
      }
    }

    lengthPicker = frame : controls.lengthPicker {
      width: 100%
    }

    // A labelled group, like Prompt and Length
    settingsGroup = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 6px},
      padding-top: 6px,
      children: [label, humorToggle],

      label = text : typeScale.caption {
        contents: "SETTINGS"
      }

      humorToggle = frame : controls.humorToggle {
        width: 100%
      }
    }

    progressMessage = text : typeScale.small {
      width: 100%,
      display: .none,
      contents: "Generating your madlib… This can take 5–30 seconds.",
      fill[0].color: palette.colors.muted
    }

    errorMessage = frame {
      width: 100%,
      height: .auto,
      display: .none,
      layout: {direction: .column},
      fill: palette.colors.errorSurface,
      border: palette.colors.error,
      padding: 12px,
      children: message,

      message = text : typeScale.small {
        width: 100%,
        contents: "That key didn't work. Check it in AI settings.",
        fill[0].color: palette.colors.error
      }
    }

    validationMessage = frame {
      width: 100%,
      height: .auto,
      display: .none,
      layout: {direction: .column, item-gap: 8px},
      border: palette.colors.outline,
      padding: 12px,
      children: [heading, issues, openAnyway],

      heading = text : typeScale.body {
        width: 100%,
        contents: "This madlib needs a few fixes."
      }

      issues = text : typeScale.small {
        width: 100%,
        contents: "• Two blanks have no word type.\n• One shared blank uses different types."
      }

      openAnyway = frame : buttons.secondary {
        height: 44px,

        label {
          contents: "OPEN ANYWAY",
          font-size: 11.52
        }
      }
    }

    actions = frame {
      width: 100%,
      height: .auto,
      layout: {
        justify-content: .space-between,
        align-items: .center,
        item-gap: 8px,
        wrap: .true,
        line-gap: 8px
      },
      children: [aiSettings, buttonsRow],

      aiSettings = frame : controls.settingsLink {}

      buttonsRow = frame {
        width: .auto,
        height: .auto,
        layout: {item-gap: 8px},
        children: [cancel, generate],

        cancel = frame : buttons.secondary {
          height: 44px,
          display: .none,
          padding-top: 0px,
          padding-left: 12px,
          padding-bottom: 0px,
          padding-right: 12px,

          label {
            contents: "CANCEL",
            font-size: 11.52
          }
        }

        generate = frame : buttons.disabled {
          height: 44px,
          padding-top: 0px,
          padding-left: 16px,
          padding-bottom: 0px,
          padding-right: 16px,

          label {
            contents: "GENERATE",
            font-size: 11.52
          }
        }
      }
    }
  }
}

