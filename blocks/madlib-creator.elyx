    padding-bottom: 12px,
    padding-right: 16px
  }

  mobileNote = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column},
    children: [line0, line1, line2, line3, line4, line5],

    line0 = frame {
      width: 100%,
      height: 22.8px,
      layout: {align-items: .center, item-gap: 4px},
      children: words,

      words = text : typeScale.body {
        contents: "Players fill each blank separately, in story",
