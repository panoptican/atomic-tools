export library = frame : dialogs.dialog {
  title: "My madlibs / Empty library",
  caption: "Existing empty library dialog. Native modal backdrop is represented in the screen.",
  meta: {code: "madlib-maker/js/drafts.js#buildDialog"},
  top: 1800px,
  width: 640px,
  padding-top: 0px,
  padding-left: 0px,
  padding-bottom: 0px,
  padding-right: 0px,
  fill[0].color: palette.colors.paper,
  layout.item-gap: 0,
  overrides: [
    insert(header, after = .nil),
    remove(dialogs.dialog.actions),
    remove(dialogs.dialog.heading)
  ],

  content {
    overrides: [
      insert(body, after = .nil),
      remove(dialogs.dialog.content.description)
    ],
    padding-top: 0px,
    padding-left: 0px,
    padding-bottom: 0px,
    padding-right: 0px
  }

  header = frame {
    width: 100%,
    height: 70.39px,
    layout: {
      justify-content: .space-between,
      align-items: .center,
      item-gap: 12px
    },
    border: {color: palette.colors.rule, sides: .bottom},
    padding: [18px, 23px],
    children: [heading, close],

    heading = text : typeScale.heading {
      contents: "My madlibs",
      font-size: 21.6,
      line-height: 1.5,
      letter-spacing: -0.5%
    }

    close = frame : buttons.secondary {
      height: 28px,
      padding-top: 0px,
      padding-left: 10px,
      padding-bottom: 0px,
      padding-right: 10px,
      border[0].color: palette.colors.rule,

      label {
        contents: "CLOSE",
        font-size: 11.52
      }
    }
  }

  body = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column},
    padding: [18px, 23px, 23px],
    children: [newRow, emptyBox, noteBox],

    newRow = frame {
      width: 100%,
      height: 60px,
      layout: {direction: .row},
      children: newMadlib,

      newMadlib = frame : buttons.button {
        height: 44px,
        padding-top: 0px,
        padding-left: 16px,
        padding-bottom: 0px,
        padding-right: 16px,

        label {
          contents: "NEW MADLIB",
          font-size: 11.52
        }
      }
    }

    emptyBox = frame {
      width: 100%,
      height: 48px,
      layout: {direction: .row},
      padding-top: 12px,
      children: empty,

      empty = text : typeScale.body {
        width: 100%,
        contents: "No saved madlibs yet. Anything you write is saved here automatically.",
        fill[0].color: madlibColors.colors.muted
      }
    }

    noteBox = frame {
      width: 100%,
      height: 38.4px,
      layout: {direction: .row},
      padding-top: 18px,
      children: note,

      note = text : typeScale.body {
        width: 100%,
        height: 38.4px,
        contents: "Madlibs are saved only in this browser.",
        font-size: 13.6,
        fill[0].color: madlibColors.colors.muted
      }
    }
  }
}

export newToast = frame : toasts.toast {
  title: "New madlib / Undo toast",
  caption: "Persistent toast after starting over from a saved madlib.",
  meta: {code: "madlib-maker/js/drafts.js#handleNewMadlib"},
  top: 2200px,
  width: .auto,
  height: 48px,
  padding-top: 12px,
  padding-left: 19px,
  padding-bottom: 12px,
  padding-right: 19px,
  layout.item-gap: 14px,
  overrides: [
    insert(dismissText, after = toasts.toast.undo),
    remove(toasts.toast.dismiss)
  ],

  message {
    width: .auto,
    contents: "Started a new madlib"
  }

  dismissText = text : typeScale.small {
    contents: "Dismiss",
    underline: .single,
    fill[0].color: palette.colors.paper
  }
}

export shareCard = frame {
  meta: {code: "madlib-maker/index.html#share-section"},
  left: 0px,
  top: 2500px,
  width: 890px,
  height: .auto,
  layout: {direction: .column},
  fill: palette.colors.surface,
  border: palette.colors.ink,
  children: [heading, body],

  heading = frame {
    width: 100%,
    height: 48.72px,
    layout: {direction: .row},
    border: {color: palette.colors.rule, sides: .bottom},
    padding: [14px, 19px],
    children: label,

    label = text : typeScale.caption {
      contents: "SHARE",
      font-size: 12.48
    }
  }

  body = frame {
    width: 100%,
    height: .auto,
    layout: {item-gap: 10px, wrap: .true, line-gap: 10px},
    padding: [18px, 19px, 19px],
    children: [player, editor, print],

    player = frame : buttons.button {
      height: 37px,
      padding-top: 0px,
      padding-left: 18px,
      padding-bottom: 0px,
      padding-right: 18px,

      label {
        contents: "SHARE WITH PLAYERS",
        font-size: 12.48
      }
    }

    editor = frame : buttons.secondary {
      height: 37px,
      padding-left: 18px,
      padding-right: 18px,
      fill[0].color: palette.colors.surface,

      label {
        contents: "COPY EDITOR LINK",
        font-size: 12.48
      }
    }

    print = frame : buttons.secondary {
      height: 37px,
      padding-left: 18px,
      padding-right: 18px,
      fill[0].color: palette.colors.surface,

      label {
        contents: "PRINT WORKSHEET",
        font-size: 12.48
      }
    }
  }
}
