import "blocks/madlib-creator.elyx" as madlib
import "tokens/colors.elyx" as palette
import "resources/assets/moon.svg" as moonAsset

lightDesktopCreator = frame : madlib.creator {
  title: "Madlib Maker / Desktop / light / creator",
  caption: "1440px · Full-page empty creator · Editable instances of extracted components",
  left: 0px,
  top: 0px,

  main {
    intro {
      actions {
        newMadlib {
          connections[0].target: lightDesktopToast,
          connections[0].label: "New madlib"
        }

        library {
          connections[0].target: lightDesktopDialog,
          connections[0].label: "My madlibs"
        }
      }
    }
  }
}

@context(theme="dark")
darkDesktopCreator = frame : lightDesktopCreator {
  title: "Madlib Maker / Desktop / dark / creator",
  left: 2200px,
  top: 0px,

  nav {
    theme {
      action {
        glyph {
          contents: moonAsset
        }
      }
    }
  }
}

lightDesktopDialog = frame {
  title: "Madlib Maker / Desktop / light / dialog",
  caption: "1440px · Viewport at page top · My madlibs open",
  left: 0px,
  top: 2100px,
  width: 1440px,
  height: 1200px,
  fill: palette.colors.paper,
  children: [page, backdrop, dialog],

  page = frame : madlib.creator {
    title: "",
    caption: "",
    left: 0px,
    top: 0px,
    width: 100%,
    height: 1281.3199px
  }

  backdrop = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    fill: rgb(0%, 0%, 0%, 40%)
  }

  dialog = frame : madlib.library {
    title: "",
    caption: "",
    left: 400px,
    top: 471.1px,

    header {
      close {
        connections[0].target: lightDesktopCreator,
        connections[0].label: "Close"
      }
    }
  }
}

@context(theme="dark")
darkDesktopDialog = frame : lightDesktopDialog {
  title: "Madlib Maker / Desktop / dark / dialog",
  left: 2200px,
  top: 2100px,

  page {
    nav {
      theme {
        action {
          glyph {
            contents: moonAsset
          }
        }
      }
    }
  }
}

lightDesktopToast = frame {
  title: "Madlib Maker / Desktop / light / toast",
  caption: "1440px · Viewport at page top · Started a new madlib, Undo and Dismiss",
  left: 0px,
  top: 3650px,
  width: 1440px,
  height: 1200px,
  fill: palette.colors.paper,
  children: [page, toast],

  page = frame : madlib.creator {
    title: "",
    caption: "",
    left: 0px,
    top: 0px,
    width: 100%,
    height: 1281.3199px
  }

  toast = frame : madlib.newToast {
    title: "",
    caption: "",
    left: 575.11px,
    top: 1128px,
    width: 289.78px
  }
}

@context(theme="dark")
darkDesktopToast = frame : lightDesktopToast {
  title: "Madlib Maker / Desktop / dark / toast",
  left: 2200px,
  top: 3650px,

  page {
    nav {
      theme {
        action {
          glyph {
            contents: moonAsset
          }
        }
      }
    }
  }
}

