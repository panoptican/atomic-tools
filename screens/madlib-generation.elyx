desktopConfirm = frame {
  title: "Desktop / Confirm / Light",
  caption: "Generate with a title or story in the editor asks first. Continue goes on to AI settings or Generate; Cancel keeps this madlib.",
  left: 6900px,
  top: 0px,
  width: 1440px,
  height: 1200px,
  fill: palette.colors.paper,
  children: [page, backdrop, dialog],

  page = frame : madlib.creator {
    title: "",
    caption: "",
    left: 0px,
    top: 0px,
    width: 100%,

    main {
      columns {
        leading {
          story {
            generateLink {
              connections[0].target: desktopConfirm,
              connections[0].label: "Editor has content"
            }

            titleBlock {
              titleInput {
                fill[0].color: palette.colors.ink,
                contents: "Pirate School"
              }
            }

            editor {
              field {
                value {
                  fill[0].color: palette.colors.ink,
                  contents: "On her first day, Captain {name:captain|A silly name?} walked into school with a {adjective|How something gross feels?} parrot."
                }

                generateHint {
                  display: .none
                }
              }
            }
          }
        }
      }
    }
  }

  backdrop = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    fill: rgb(0%, 0%, 0%, 40%)
  }

  dialog = frame : generation.confirmDialog {
    title: "",
    caption: "",
    left: 400px,
    top: 240px,
    width: 640px,

    confirmBody {
      actions {
        continueButton {
          connections[0].target: desktopGenerate,
          connections[0].label: "Continue (saved key)"
        }
      }
    }
  }
}

@context(theme="dark")
desktopConfirmDark = frame : desktopConfirm {
  title: "Desktop / Confirm / Dark",
  left: 6900px,
  top: 1550px,

