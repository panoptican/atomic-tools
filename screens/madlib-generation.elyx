import "blocks/madlib-creator.elyx" as madlib
import "controls/madlib-generate.elyx" as controls
import "tokens/colors.elyx" as palette
import "resources/assets/moon.svg" as moonAsset
import "blocks/madlib-generation.elyx" as generation

@with-context()
file {}

desktopGenerate = frame {
  title: "Desktop / Generate / Light",
  caption: "Existing creator · Generate at the top right of Story · Same modal shell as My madlibs.",
  left: 0px,
  top: 0px,
  width: 1440px,
  height: 1200px,
  fill: palette.colors.paper,
  children: [page, backdrop, dialog],

  page = frame : madlib.creator {
    title: "",
    caption: "",
    left: 0px,
    top: 0px,
    width: 100%,

    main {
      columns {
        leading {
          story {
            generateLink {
              connections[1].target: desktopSettings,
              connections[0].target: desktopGenerate,
              connections[1].label: "No saved key",
              connections[0].label: "Saved key"
            }
          }
        }
      }
    }
  }

  backdrop = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%,
    fill: rgb(0%, 0%, 0%, 40%)
  }

  dialog = frame : generation.generateReady {
    title: "",
    left: 400px,
    top: 240px,

    generateForm {
      actions {
        aiSettings {
          connections[0].target: desktopSettings,
          connections[0].label: "AI settings"
        }
      }
    }
  }
}

@context(theme="dark")
desktopGenerateDark = frame : desktopGenerate {
  title: "Desktop / Generate / Dark",
  left: 0px,
  top: 1550px,

  page {
    nav {
      theme {
        action {
          glyph {
            contents: moonAsset
          }
        }
      }
    }
  }
}

